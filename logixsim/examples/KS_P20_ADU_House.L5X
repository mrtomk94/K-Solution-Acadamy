</Tag>
<Tag Name="ADU_Smoke_Horn" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[All smoke alarms sounding (interconnected).]]>
