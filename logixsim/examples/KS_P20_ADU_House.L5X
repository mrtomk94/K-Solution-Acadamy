</Tag>
<Tag Name="ADU_LT_Porch" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Front porch light.]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
