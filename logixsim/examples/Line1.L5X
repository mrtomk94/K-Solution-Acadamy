   <Tag Name="Z39" DataType="DINT" Dimensions="0"/>
  </Tags>
  <Programs>
   <Program Name="MainProgram" MainRoutineName="MainRoutine">
    <Tags>
     <Tag Name="Local" DataType="DINT" Dimensions="0"/>
    </Tags>
    <Routines>
     <Routine Name="MainRoutine" Type="RLL">
      <RLLContent>
       <Rung Number="0" Type="N"><Text>XIC(Start)OTE(Running);</Text></Rung>
       <Rung Number="1" Type="N"><Text>XIC(Running)JSR(Calc);</Text></Rung>
      </RLLContent>
     </Routine>
     <Routine Name="Calc" Type="ST">
      <STContent>
       <Line Number="0">Count := Count + 1;</Line>
       <Line Number="1">IF Count &gt; 10 THEN Count := 0; END_IF;</Line>
      </STContent>
     </Routine>
    </Routines>
   </Program>
  </Programs>
  <Tasks>
   <Task Name="MainTask" Type="CONTINUOUS">
    <ScheduledPrograms><ScheduledProgram Name="MainProgram"/></ScheduledPrograms>
   </Task>
  </Tasks>
 </Controller>
</RSLogix5000Content>
