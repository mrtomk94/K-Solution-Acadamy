<?xml version="1.0" encoding="UTF-8"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.00">
 <Controller Name="DemoCtrl">
  <DataTypes>
   <DataType Name="Motor_t">
    <Members>
     <Member Name="Run" DataType="BOOL" Dimension="0"/>
     <Member Name="Spd" DataType="REAL" Dimension="0"/>
     <Member Name="Faults" DataType="DINT" Dimension="4"/>
    </Members>
   </DataType>
  </DataTypes>
  <AddOnInstructionDefinitions>
   <AddOnInstructionDefinition Name="Scale" MainRoutineName="Logic">
    <Parameters>
     <Parameter Name="In" DataType="REAL"/>
     <Parameter Name="Out" DataType="REAL"/>
    </Parameters>
    <Routines>
     <Routine Name="Logic" Type="ST">
      <STContent><Line Number="0">Out := In * 2.0;</Line></STContent>
     </Routine>
    </Routines>
   </AddOnInstructionDefinition>
  </AddOnInstructionDefinitions>
  <Tags>
   <Tag Name="Start" DataType="BOOL" Dimensions="0"/>
   <Tag Name="Stop" DataType="BOOL" Dimensions="0"/>
   <Tag Name="Running" DataType="BOOL" Dimensions="0"/>
   <Tag Name="Count" DataType="DINT" Dimensions="0"/>
   <Tag Name="Rate" DataType="REAL" Dimensions="0"/>
   <Tag Name="T1" DataType="TIMER" Dimensions="0"/>
   <Tag Name="C1" DataType="COUNTER" Dimensions="0"/>
   <Tag Name="M1" DataType="Motor_t" Dimensions="0"/>
   <Tag Name="Line" DataType="Motor_t" Dimensions="3"/>
   <Tag Name="Arr" DataType="DINT" Dimensions="10"/>
   <Tag Name="Speeds" DataType="REAL" Dimensions="400"/>
   <Tag Name="Small" DataType="SINT" Dimensions="0"/>
   <Tag Name="Mid" DataType="INT" Dimensions="0"/>
   <Tag Name="Flags" DataType="BOOL" Dimensions="8"/>
   <Tag Name="Z00" DataType="DINT" Dimensions="0"/>
   <Tag Name="Z01" DataType="DINT" Dimensions="0"/>
   <Tag Name="Z02" DataType="DINT" Dimensions="0"/>
